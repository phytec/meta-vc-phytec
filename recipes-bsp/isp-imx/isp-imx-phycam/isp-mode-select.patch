diff -ru a/isp-mode-select-csi1.sh b/isp-mode-select-csi1.sh
--- a/isp-mode-select-csi1.sh	2025-10-17 18:01:29.791424842 +0200
+++ b/isp-mode-select-csi1.sh	2025-10-20 11:48:55.881477148 +0200
@@ -62,7 +62,7 @@
 	exit 0
 }
 
-OPTIONS="hLMm:l:p:"
+OPTIONS="hLMm:l:p:W:H:"
 MODE=
 LENS=
 PORT=0
@@ -75,6 +75,8 @@
 		m ) MODE=$OPTARG;;
 		l ) LENS=$OPTARG;;
 		p ) PORT=$OPTARG;;
+		W ) WIDTH=$OPTARG;;
+		H ) HEIGHT=$OPTARG;;
 		L ) LIST_LENSES=1;;
 		M ) LIST_MODES=1;;
 		h  ) display_help; exit;;
@@ -111,6 +113,68 @@
 	COLOR="col"
 fi
 
+if [ "$SENSOR_NAME" = "vc-mipi-cam" ] ; then
+	SENSOR_TYPE=$(i2cdump -f -y 2 0x10 c 0x10 | grep -oE "(IMX|OV)[0-9]*C?")
+
+    if [ -z "${WIDTH}" ] || [ -z "${HEIGHT}" ]; then
+		case "${SENSOR_TYPE}" in
+			IMX178|IMX178C) WIDTH=3072; HEIGHT=2048 ;;
+			IMX183|IMX183C) WIDTH=5440; HEIGHT=3648 ;;
+			IMX226|IMX226C) WIDTH=3904; HEIGHT=3000 ;;
+			IMX250|IMX250C) WIDTH=2432; HEIGHT=2048 ;;
+			IMX252|IMX252C) WIDTH=2048; HEIGHT=1536 ;;
+			IMX264|IMX264C) WIDTH=2432; HEIGHT=2048 ;;
+			IMX265|IMX265C) WIDTH=2048; HEIGHT=1536 ;;
+			IMX273|IMX273C) WIDTH=1440; HEIGHT=1080 ;;
+			IMX290|IMX290C) WIDTH=1920; HEIGHT=1080 ;;
+			IMX296|IMX296C) WIDTH=1440; HEIGHT=1080 ;;
+			IMX297|IMX297C) WIDTH=704;  HEIGHT=540  ;;
+			IMX327|IMX327C) WIDTH=1920; HEIGHT=1080 ;;
+			IMX335|IMX335C) WIDTH=2592; HEIGHT=1944 ;;
+			IMX392|IMX392C) WIDTH=1920; HEIGHT=1200 ;;
+			IMX412|IMX412C) WIDTH=4032; HEIGHT=3040 ;;
+			IMX415|IMX415C) WIDTH=3840; HEIGHT=2160 ;;
+			IMX462|IMX462C) WIDTH=1920; HEIGHT=1080 ;;
+			IMX565|IMX565C) WIDTH=4128; HEIGHT=3000 ;;
+			IMX566|IMX566C) WIDTH=2848; HEIGHT=2848 ;;
+			IMX567|IMX567C) WIDTH=2464; HEIGHT=2064 ;;
+			IMX568|IMX568C) WIDTH=2464; HEIGHT=2064 ;;
+			IMX900|IMX900C) WIDTH=2048; HEIGHT=1536 ;;
+			OV7251|OV7251C) WIDTH=640;  HEIGHT=480  ;;
+			OV9281|OV9281C) WIDTH=1280; HEIGHT=800  ;;
+			* ) echo "Unknown Sensor Type: ${SENSOR_TYPE}"; exit 1
+		esac
+	fi
+
+	DWE_PATH="/opt/imx8-isp/bin/dwe/"
+	DWE_FILE_NAME="vc_${SENSOR_TYPE}_dewarp_csi1.json"
+	DWE_FILE="${DWE_PATH}${DWE_FILE_NAME}"
+	DWE_TEMPLATE="/opt/imx8-isp/bin/vc_mipi_dewarp_template.json"
+	XML_PATH="/opt/imx8-isp/bin/xml/"
+	XML_FILE_NAME="vc_${SENSOR_TYPE}_tuning_csi1.xml"
+	XML_FILE="${XML_PATH}${XML_FILE_NAME}"
+	XML_TEMPLATE="/opt/imx8-isp/bin/vc_mipi_tuning_template_${COLOR}.xml"
+	ISP_SENSOR_FILE="/opt/imx8-isp/bin/Sensor0_Entry.cfg"
+	SENSOR_FILE="${ISP_SENSOR_FILE}.${SENSOR_TYPE}"
+
+	sed -e "s/{width}/${WIDTH}/g" -e "s/{height}/${HEIGHT}/g" "${DWE_TEMPLATE}" > "${DWE_FILE}"
+	sed -e "s/{width}/${WIDTH}/g" -e "s/{height}/${HEIGHT}/g" "${XML_TEMPLATE}" > "${XML_FILE}"
+
+	{
+		echo "name=\"vc-mipi-vvcam\""
+		echo "drv = \"vc-mipi.drv\""
+		echo "mode= 0"
+		echo ""
+		echo "[mode.0]"
+		echo "xml = \"xml/${XML_FILE_NAME}\""
+		echo "dwe = \"dwe/${DWE_FILE_NAME}\""
+	} > "${SENSOR_FILE}"
+
+	ln -sf "${SENSOR_FILE}" "${ISP_SENSOR_FILE}"
+
+	exit 0
+fi
+
 if [ $LIST_MODES = 1 ] ; then
 	display_modes ${SENSOR_NAME}
 fi
