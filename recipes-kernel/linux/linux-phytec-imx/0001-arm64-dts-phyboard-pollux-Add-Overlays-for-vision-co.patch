diff --git a/arch/arm64/boot/dts/freescale/imx8mp-phyboard-pollux-vc-sony-2lanes-csi1.dtso b/arch/arm64/boot/dts/freescale/imx8mp-phyboard-pollux-vc-sony-2lanes-csi1.dtso
new file mode 100644
index 000000000000..00af65786673
--- /dev/null
+++ b/arch/arm64/boot/dts/freescale/imx8mp-phyboard-pollux-vc-sony-2lanes-csi1.dtso
@@ -0,0 +1,53 @@
+// SPDX-License-Identifier:_(GPL-2.0+_OR_MIT)
+/*
+ * Copyright (C) 2025 PHYTEC Messtechnik GmbH
+ * Author: Stefan Riedmüller <s.riedmueller@phytec.de>
+ */
+
+/dts-v1/;
+/plugin/;
+
+/*
+ * Sony Sensor Lane Support:
+ * -------------------------
+ *  2   Lanes: IMX264, IMX265
+ *  2,4 Lanes: IMX178, IMX183, IMX226, IMX250, IMX252, IMX273, IMX290, IMX327,
+ *	       IMX335, IMX392, IMX412, IMX415, IMX568, IMX900
+ */
+
+&csi1_i2c {
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	vc_mipi@1a {
+		reg = <0x1a>;
+		compatible = "vc,vc_mipi";
+		csi_id = <0>;
+		status = "okay";
+
+		port {
+			vc_mipi_ep_0: endpoint {
+				data-lanes = <1 2>;
+				clock-lanes = <0>;
+				remote-endpoint  = <&mipi_csi0_ep>;
+			};
+		};
+	};
+};
+
+&mipi_csi_0 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	port@0 {
+		reg = <0>;
+
+		mipi_csi0_ep: endpoint {
+			remote-endpoint = <&vc_mipi_ep_0>;
+			data-lanes = <2>;
+			csis-hs-settle = <33>;
+			csis-clk-settle = <2>;
+			csis-wclk;
+		};
+	};
+};
