+			  imx8mp-phyboard-pollux-vc-sony-4lanes-csi1.dtbo
+imx8mp-phyboard-pollux-vc-sony-2lanes-csi2-dtbs += imx8mp-phyboard-pollux-rdk.dtb \
+			  imx8mp-phyboard-pollux-vc-sony-2lanes-csi2.dtbo
