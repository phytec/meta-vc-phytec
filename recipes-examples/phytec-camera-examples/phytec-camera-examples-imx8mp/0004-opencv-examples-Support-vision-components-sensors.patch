diff --git a/phytec-opencv-examples/python/vc_mipi.py b/phytec-opencv-examples/python/vc_mipi.py
new file mode 100755
index 000000000000..f756fed58596
--- /dev/null
+++ b/phytec-opencv-examples/python/vc_mipi.py
@@ -0,0 +1,139 @@
+import cv2
+import subprocess
+import re
+
+
+vc_cams = {
+    "IMX178": {"width": 3072, "height": 2048, "bit_widths": [8, 10, 12]},
+    "IMX183": {"width": 5440, "height": 3648, "bit_widths": [10, 12]},
+    "IMX226": {"width": 3904, "height": 3000, "bit_widths": [10, 12]},
+    "IMX250": {"width": 2432, "height": 2048, "bit_widths": [8, 10, 12]},
+    "IMX252": {"width": 2048, "height": 1536, "bit_widths": [8, 10, 12]},
+    "IMX264": {"width": 2432, "height": 2048, "bit_widths": [8, 10, 12]},
+    "IMX265": {"width": 2048, "height": 1536, "bit_widths": [8, 10, 12]},
+    "IMX273": {"width": 1440, "height": 1080, "bit_widths": [8, 10, 12]},
+    "IMX290": {"width": 1920, "height": 1080, "bit_widths": [10]},
+    "IMX296": {"width": 1440, "height": 1080, "bit_widths": [10]},
+    "IMX297": {"width": 704,  "height": 540,  "bit_widths": [10]},
+    "IMX327": {"width": 1920, "height": 1080, "bit_widths": [10]},
+    "IMX335": {"width": 2592, "height": 1944, "bit_widths": [10, 12]},
+    "IMX392": {"width": 1920, "height": 1200, "bit_widths": [8, 10, 12]},
+    "IMX412": {"width": 4032, "height": 3040, "bit_widths": [10, 12]},
+    "IMX415": {"width": 3840, "height": 2160, "bit_widths": [10, 12]},
+    "IMX462": {"width": 1920, "height": 1080, "bit_widths": [10]},
+    "IMX565": {"width": 4128, "height": 3000, "bit_widths": [8, 10, 12]},
+    "IMX566": {"width": 2848, "height": 2848, "bit_widths": [8, 10, 12]},
+    "IMX567": {"width": 2464, "height": 2064, "bit_widths": [8, 10, 12]},
+    "IMX568": {"width": 2464, "height": 2064, "bit_widths": [8, 10, 12]},
+    "IMX900": {"width": 2048, "height": 1536, "bit_widths": [8, 10, 12]},
+    "OV7251": {"width": 640,  "height": 480,  "bit_widths": [8, 10]},
+    "OV9281": {"width": 1280, "height": 800,  "bit_widths": [8, 10]},
+}
+
+def get_vc_mipi_sensor_type():
+    command = ["i2cdump", "-f", "-y", "2", "0x10", "c", "0x10"]
+    result = subprocess.run(command, capture_output=True)
+
+    match = re.search(r"((IMX|OV)[0-9]*)C?", result.stdout.decode())
+    if match:
+        sensor_type = match.group(1)
+    else:
+        raise RuntimeError("Could not identify VC-MIPI-CAM sensor type.")
+
+    return vc_cams[sensor_type]
+
+
+def get_vc_mipi_formats(isp=False):
+    sensor = get_vc_mipi_sensor_type()
+
+    if not isp and not sensor['bit_widths'][0] == 8:
+        raise RuntimeError(f"VC-MIPI-CAM does not support 8 Bit formats.")
+
+    formats = {
+        "color": {
+            "cam": f"SRGGB{sensor['bit_widths'][0]}_1X{sensor['bit_widths'][0]}",
+            "opencv": cv2.COLOR_BAYER_BG2BGR,
+            "gst": "video/x-bayer,format=rggb",
+            "controls": [],
+        },
+        "monochrome": {
+            "cam": f"Y{sensor['bit_widths'][0]}_1X{sensor['bit_widths'][0]}",
+            "opencv": None,
+            "gst": "video/x-raw,format=GRAY8",
+            "controls": [],
+        },
+    }
+
+    formats_isp = {
+        "color": {
+            "cam": f"SRGGB{sensor['bit_widths'][-1]}_1X{sensor['bit_widths'][-1]}",
+            "opencv": cv2.COLOR_YUV2BGRA_YUY2,
+            "gst": "video/x-raw,format=YUY2",
+            "controls": [],
+        },
+        "monochrome": {
+            "cam": f"Y{sensor['bit_widths'][-1]}_1X{sensor['bit_widths'][-1]}",
+            "opencv": cv2.COLOR_YUV2BGRA_YUY2,
+            "gst": "video/x-raw,format=YUY2",
+            "controls": [],
+        },
+    }
+
+    if isp:
+        return formats_isp
+
+    return formats
+
+
+def get_vc_mipi_modes(isp=False):
+    sensor = get_vc_mipi_sensor_type()
+    if not sensor:
+        return None
+
+    width = sensor["width"]
+    height = sensor["height"]
+    hd_left = (width - 1280) / 2
+    hd_top = (height - 720) / 2
+
+    modes = {
+        "Full": {
+            "name": f"{width}x{height} Full",
+            "width": width,
+            "height": height,
+            "offset": "(0,0)",
+            "cap_width": width,
+            "cap_height": height,
+            "controls": [],
+        },
+        "HD": {
+            "name": "1280x720 HD",
+            "width": 1280,
+            "height": 720,
+            "offset": f"({hd_left},{hd_top})",
+            "cap_width": 1280,
+            "cap_height": 720,
+            "controls": [],
+        },
+    }
+
+    modes_isp = {
+        "Full": {
+            "name": f"{width}x{height} Full",
+            "mode": 0,
+            "cap_width": width,
+            "cap_height": height,
+            "controls": [],
+        },
+        "HD": {
+            "name": "1280x720 HD ISP Scaling",
+            "mode": 0,
+            "cap_width": 1280,
+            "cap_height": 720,
+            "controls": [],
+        },
+    }
+
+    if isp:
+        return modes_isp
+
+    return modes
